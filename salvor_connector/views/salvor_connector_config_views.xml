<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="salvor_connector_config_view_form" model="ir.ui.view">
        <field name="name">salvor.connector.config.form</field>
        <field name="model">salvor.connector.config</field>
        <field name="arch" type="xml">
            <form string="Salvor Connector" create="0" delete="0" duplicate="0">
                <header>
                    <button name="action_connect" type="object" string="Connect" class="btn-primary"/>
                    <button name="action_rotate" type="object" string="Rotate token" invisible="not is_paired"/>
                    <button name="action_view_log" type="object" string="Pull log"/>
                    <button name="action_disconnect" type="object" string="Disconnect"
                            invisible="not is_paired"
                            confirm="Salvor will no longer be able to back up this database. Continue?"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Salvor Connector</h1>
                    </div>
                    <div class="alert alert-success" role="status"
                         invisible="not is_paired or not enabled or connection_state in ('failed', 'refused', 'timeout', 'unknown')">
                        Connected to Salvor. Backups of this database can be taken by Salvor from the allowed IPs below.
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="not leftover_drill_count">
                        A restore drill run by Salvor Connector 2.0.0 or 2.0.1 left
                        <b><field name="leftover_drill_count" readonly="1" class="oe_inline"/></b>
                        scratch database(s) named salvor_drill_* on this server: full copies of this database,
                        logins included. They are dropped automatically after 24 hours.
                        <button name="action_drop_drills" type="object" string="Drop them now"
                                class="btn-link" groups="base.group_system"
                                confirm="Drop every drill database this connector created? Their data is deleted."/>
                    </div>
                    <div class="alert alert-danger" role="alert"
                         invisible="not is_paired or not enabled or connection_state != 'failed' or offer_cloudflare">
                        Paired, but Salvor could not reach this database when it tested the connection at pairing:
                        <field name="connection_message" readonly="1" class="oe_inline"/>
                        After you fix the cause, choose Test connection in Salvor, or run a backup from Salvor.
                        This notice clears when Salvor reaches this database.
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="not offer_cloudflare or not enabled">
                        Paired, but Odoo refused Salvor's connection test: the request reached Odoo from a
                        Cloudflare address, and "Odoo is behind Cloudflare" is switched off.
                        <button name="action_trust_cloudflare" type="object"
                                string="My Odoo is behind Cloudflare: switch it on"
                                class="btn btn-secondary d-block my-2" groups="base.group_system"/>
                        With it on, the address check relies on the CF-Connecting-IP header that Cloudflare adds,
                        which does not show that a request came through your own zone: the access token remains
                        the protection. To let only your own zone reach Odoo, set up zone-level or per-hostname
                        Authenticated Origin Pulls. After you switch it on, choose Test connection in Salvor, or
                        run a backup from Salvor.
                    </div>
                    <div class="alert alert-danger" role="alert"
                         invisible="not is_paired or not enabled or connection_state != 'refused'">
                        <field name="connection_message" readonly="1" class="oe_inline"/>
                        This notice clears when Salvor reaches this database.
                    </div>
                    <div class="alert alert-info" role="status"
                         invisible="not is_paired or not enabled or connection_state not in ('timeout', 'unknown')">
                        Paired with Salvor, but the connection is not tested:
                        <field name="connection_message" readonly="1" class="oe_inline"/>
                    </div>
                    <div class="alert alert-warning" role="status" invisible="not is_paired or enabled">
                        Paired, but the Connector is disabled: Odoo refuses every call from Salvor until Enabled is ticked again.
                    </div>
                    <div class="alert alert-warning" role="status" invisible="is_paired">
                        Not connected. In Salvor choose "Add database" then "Connector", paste the pairing code here and click Connect.
                        No Salvor account yet?
                        <a href="https://salvorcloud.com/?utm_source=odoo-module&amp;utm_medium=product&amp;utm_campaign=connector-settings" target="_blank" rel="noopener noreferrer">Create one</a>
                        (14-day free trial, no card), then come back here with the pairing code.
                    </div>
                    <group>
                        <group string="Pairing">
                            <field name="is_paired" invisible="1"/>
                            <field name="offer_cloudflare" invisible="1"/>
                            <field name="salvor_url"/>
                            <field name="pairing_code" placeholder="SLV-XXXX-XXXX"/>
                            <field name="paired_at"/>
                            <field name="instance_id"/>
                            <field name="last_call_at"/>
                            <field name="connection_state" invisible="not connection_state"/>
                            <field name="checked_at" invisible="not checked_at"/>
                        </group>
                        <group string="Access">
                            <field name="enabled"/>
                            <field name="allowed_ips" placeholder="One IP or CIDR per line"/>
                            <field name="trust_cloudflare"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_salvor_connector_config" model="ir.actions.server">
        <field name="name">Salvor Connector</field>
        <field name="model_id" ref="model_salvor_connector_config"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open()</field>
    </record>

    <record id="salvor_connector_log_view_list" model="ir.ui.view">
        <field name="name">salvor.connector.log.list</field>
        <field name="model">salvor.connector.log</field>
        <field name="arch" type="xml">
            <list string="Salvor pull log" create="0" edit="0" delete="0"
                  decoration-danger="http_status &gt;= 400" decoration-muted="http_status &lt; 300 and endpoint == 'info'">
                <field name="date"/>
                <field name="endpoint"/>
                <field name="http_status"/>
                <field name="result"/>
                <field name="remote_addr"/>
                <field name="job_id" optional="hide"/>
                <field name="bytes" optional="show"/>
                <field name="detail"/>
            </list>
        </field>
    </record>

    <record id="salvor_connector_log_view_search" model="ir.ui.view">
        <field name="name">salvor.connector.log.search</field>
        <field name="model">salvor.connector.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="endpoint"/>
                <field name="remote_addr"/>
                <field name="job_id"/>
                <filter name="refused" string="Refused" domain="[('http_status', '&gt;=', 400)]"/>
                <filter name="backups" string="Backups" domain="[('endpoint', 'like', 'backup')]"/>
            </search>
        </field>
    </record>

    <record id="action_salvor_connector_log" model="ir.actions.act_window">
        <field name="name">Salvor Pull Log</field>
        <field name="res_model">salvor.connector.log</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No calls from Salvor yet</p>
            <p>Requests Salvor makes to this database — and refusals — are listed here (status polls are not).
               Rows older than 90 days are removed (system parameter salvor_connector.log_retention_days).</p>
        </field>
    </record>

    <menuitem id="menu_salvor_connector_root"
              name="Salvor Connector"
              parent="base.menu_administration"
              groups="base.group_system"
              sequence="90"/>
    <menuitem id="menu_salvor_connector"
              name="Settings"
              parent="menu_salvor_connector_root"
              action="action_salvor_connector_config"
              groups="base.group_system"
              sequence="10"/>
    <menuitem id="menu_salvor_connector_log"
              name="Pull Log"
              parent="menu_salvor_connector_root"
              action="action_salvor_connector_log"
              groups="base.group_system"
              sequence="20"/>
</odoo>
