<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="salvor_connector_config_view_form" model="ir.ui.view">
        <field name="name">salvor.connector.config.form</field>
        <field name="model">salvor.connector.config</field>
        <field name="arch" type="xml">
            <form string="Salvor Connector" create="0" delete="0" duplicate="0">
                <header>
                    <button name="action_connect" type="object" string="Connect" class="btn-primary"/>
                    <button name="action_disconnect" type="object" string="Disconnect"
                            invisible="not is_paired"
                            confirm="Salvor will no longer be able to back up this database. Continue?"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Salvor Connector</h1>
                    </div>
                    <div class="alert alert-success" role="status" invisible="not is_paired">
                        Connected to Salvor. Backups of this database can be taken by Salvor from the allowed IPs below.
                    </div>
                    <div class="alert alert-warning" role="status" invisible="is_paired">
                        Not connected. In Salvor choose "Add database" then "Connector", paste the pairing code here and click Connect.
                    </div>
                    <group>
                        <group string="Pairing">
                            <field name="is_paired" invisible="1"/>
                            <field name="salvor_url"/>
                            <field name="pairing_code" placeholder="SLV-XXXX-XXXX"/>
                            <field name="paired_at"/>
                            <field name="instance_id"/>
                            <field name="last_call_at"/>
                        </group>
                        <group string="Access">
                            <field name="enabled"/>
                            <field name="drill_enabled"/>
                            <field name="allowed_ips" placeholder="One IP or CIDR per line"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_salvor_connector_config" model="ir.actions.server">
        <field name="name">Salvor Connector</field>
        <field name="model_id" ref="model_salvor_connector_config"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open()</field>
    </record>

    <menuitem id="menu_salvor_connector"
              name="Salvor Connector"
              parent="base.menu_custom"
              action="action_salvor_connector_config"
              groups="base.group_system"
              sequence="200"/>
</odoo>
